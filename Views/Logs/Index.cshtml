@model List<ABCRetail.AzureStorage.Services.FileLogInfo>

@{
    ViewData["Title"] = "Logs";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Logs (Azure Files)</h4>
</div>

<p class="text-muted">
    All log files below are stored in Azure Files, written automatically by the background
    order-processing worker whenever a queue message is handled.
</p>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Log File</th>
                    <th class="text-end">View</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr>
                        <td colspan="2" class="text-center text-muted py-4">
                            No logs yet. Go to Orders &amp; Inventory and simulate an order first.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td>@log.Name</td>
                            <td class="text-end">
                                <a href="@Url.Action("View", "Logs", new { fileName = log.Name })"
                                   target="_blank" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye"></i> View
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
