@model IEnumerable<ABCRetail.AzureStorage.Services.FileLogInfo>

@{
    ViewData["Title"] = "System Logs";
}

<div class="card-custom border-0 shadow-sm mb-4 overflow-hidden" style="background: #fff; border-radius: 1rem;">
    <!-- Stylish Header -->
    <div class="p-4 border-bottom bg-light bg-opacity-50">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 54px; height: 54px;">
                <i class="bi bi-file-earmark-code fs-3"></i>
            </div>
            <div>
                <h5 class="fw-bold text-dark mb-1">Azure Files Audit Logs</h5>
                <p class="text-muted small mb-0" style="max-width: 600px;">
                    All system log files below are stored securely in Azure Files. They are generated automatically by the background order-processing worker whenever a queue message is handled.
                </p>
            </div>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <!-- Empty State -->
        <div class="p-5 text-center">
            <div class="d-flex flex-column align-items-center justify-content-center py-4">
                <i class="bi bi-folder2-open text-muted mb-3" style="font-size: 3rem; opacity: 0.5;"></i>
                <h6 class="fw-bold text-dark mb-1">No Logs Found</h6>
                <p class="text-muted small">Once an order is processed via the queue, audit logs will appear here.</p>
            </div>
        </div>
    }
    else
    {
        <!-- Modern Table -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase" style="letter-spacing: 0.5px;">
                    <tr>
                        <th class="ps-4 fw-semibold border-bottom-0 py-3">File Name</th>
                        <th class="fw-semibold border-bottom-0 py-3">Storage Origin</th>
                        <th class="text-end pe-4 fw-semibold border-bottom-0 py-3">Action</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-light text-secondary rounded d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                        <i class="bi bi-file-text fs-5"></i>
                                    </div>
                                    <span class="fw-medium text-dark font-monospace small">@log.Name</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-secondary border fw-normal px-2 py-1">Azure File Share</span>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="View" asp-route-fileName="@log.Name" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" target="_blank">
                                    <i class="bi bi-eye me-1"></i> View Log
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>