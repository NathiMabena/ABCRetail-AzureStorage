@model ABCRetail.AzureStorage.Models.DashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard";
    var productNamesJson = JsonSerializer.Serialize(Model.ProductNames);
    var productStockJson = JsonSerializer.Serialize(Model.ProductStockLevels);
}

<!-- Action Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1" style="color: #0f172a;">Overview</h3>
        <p class="text-muted small mb-0">Real-time inventory and fulfillment metrics from Azure Storage.</p>
    </div>
</div>

<!-- Stat Cards Grid with Lift & Glow Hover Effect -->
<div class="row g-3 mb-4">
    <!-- Total Customers -->
    <div class="col-md-3">
        <div class="stat-card p-3">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="text-muted small fw-semibold">Total Customers</span>
                <div class="icon-shape bg-primary-subtle text-primary">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
            <div class="d-flex align-items-baseline">
                <span class="fs-2 fw-bold text-dark me-2">@Model.TotalCustomers</span>

                @if (Model.TotalCustomers > 0)
                {
                    <span class="badge bg-success-subtle text-success small fw-medium">
                        <i class="bi bi-arrow-up-short"></i> Active
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary small fw-medium">
                        <i class="bi bi-dash"></i> Inactive
                    </span>
                }
            </div>
        </div>
    </div>

    <!-- Total Products -->
    <div class="col-md-3">
        <div class="stat-card p-3">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="text-muted small fw-semibold">Total Products</span>
                <div class="icon-shape bg-info-subtle text-info">
                    <i class="bi bi-box-seam-fill"></i>
                </div>
            </div>
            <div class="d-flex align-items-baseline">
                <span class="fs-2 fw-bold text-dark me-2">@Model.TotalProducts</span>
                <span class="text-muted small">Items listed</span>
            </div>
        </div>
    </div>

    <!-- Total Orders -->
    <div class="col-md-3">
        <div class="stat-card p-3">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="text-muted small fw-semibold">Total Orders</span>
                <div class="icon-shape bg-success-subtle text-success">
                    <i class="bi bi-cart-check-fill"></i>
                </div>
            </div>
            <div class="d-flex align-items-baseline">
                <span class="fs-2 fw-bold text-dark me-2">@Model.TotalOrders</span>
                <span class="text-muted small">Processed</span>
            </div>
        </div>
    </div>

    <!-- Low Stock Alerts -->
    <div class="col-md-3">
        <div class="stat-card p-3 @(Model.LowStockProducts.Count > 0 ? "border-danger-subtle" : "")">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="text-muted small fw-semibold">Low Stock Products</span>
                <div class="icon-shape bg-danger-subtle text-danger">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
            </div>
            <div class="d-flex align-items-baseline">
                <span class="fs-2 fw-bold @(Model.LowStockProducts.Count > 0 ? "text-danger" : "text-dark") me-2">
                    @Model.LowStockProducts.Count
                </span>
                <span class="text-muted small">Needs restock</span>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-3 mb-4">
    <!-- Bar Chart -->
    <div class="col-lg-7">
        <div class="card-custom p-3 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0" style="color: #0f172a;">Inventory Levels by Product</h6>
                <span class="badge bg-light text-secondary border">Azure Table Storage</span>
            </div>
            <div class="position-relative" style="min-height: 240px;">
                <canvas id="stockChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Donut Chart -->
    <div class="col-lg-5">
        <div class="card-custom p-3 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0" style="color: #0f172a;">Order Status Breakdown</h6>
                <span class="badge bg-light text-secondary border">Azure Queue</span>
            </div>
            <div class="position-relative d-flex align-items-center justify-content-center" style="min-height: 240px;">
                <canvas id="orderStatusChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Low Stock Table Section -->
@if (Model.LowStockProducts.Count > 0)
{
    <div class="card-custom border-danger-subtle overflow-hidden mb-4">
        <div class="card-header bg-danger-subtle text-danger d-flex align-items-center gap-2 py-3">
            <i class="bi bi-exclamation-circle-fill fs-5" style="margin-right: 8px;"></i>
            <span class="fw-bold mb-0">Low Stock Warning</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Product Name</th>
                        <th class="text-end pe-4">Remaining Stock</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.LowStockProducts)
                    {
                        <tr>
                            <td class="ps-4 fw-medium text-dark">@product.Name</td>
                            <td class="text-end pe-4">
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1.5 rounded-pill">
                                    @product.StockQuantity units left
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Inventory Stock Bar Chart
            const stockCtx = document.getElementById('stockChart').getContext('2d');

            // Create soft indigo gradient for bars
            const gradient = stockCtx.createLinearGradient(0, 0, 0, 300);
            gradient.addColorStop(0, '#4f46e5');
            gradient.addColorStop(1, '#818cf8');

            new Chart(stockCtx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(productNamesJson),
                    datasets: [{
                        label: 'Stock Quantity',
                        data: @Html.Raw(productStockJson),
                        backgroundColor: gradient,
                        borderRadius: 6,
                        borderSkipped: false
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            padding: 12,
                            backgroundColor: '#0f172a',
                            titleFont: { family: 'Inter', size: 13, weight: 'bold' },
                            bodyFont: { family: 'Inter', size: 12 }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { font: { family: 'Inter', size: 12 }, color: '#64748b' }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: '#f1f5f9' },
                            ticks: { font: { family: 'Inter', size: 12 }, color: '#64748b' }
                        }
                    }
                }
            });

            // Order Status Donut Chart
            const orderStatusCtx = document.getElementById('orderStatusChart').getContext('2d');
            new Chart(orderStatusCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Pending', 'Processed'],
                    datasets: [{
                        data: [@Model.PendingOrders, @Model.ProcessedOrders],
                        backgroundColor: ['#f59e0b', '#10b981'],
                        borderWidth: 4,
                        borderColor: '#ffffff',
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '75%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                usePointStyle: true,
                                padding: 20,
                                font: { family: 'Inter', size: 12, weight: '500' }
                            }
                        },
                        tooltip: {
                            padding: 12,
                            backgroundColor: '#0f172a'
                        }
                    }
                }
            });
        });
    </script>
}