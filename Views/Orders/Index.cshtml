@model IEnumerable<ABCRetail.AzureStorage.Models.OrderEntity>

@{
    ViewData["Title"] = "Orders & Inventory";
}

@section TopbarActions {
    <div class="d-flex align-items-center">
        <!-- The New Manual Processing Button -->
        <form asp-controller="Orders" asp-action="ProcessPendingOrders" method="post" class="d-inline">
            <button type="submit" class="btn btn-warning rounded-pill px-4 shadow-sm fw-medium me-3">
                <i class="bi bi-gear-fill me-2"></i> Process Queue
            </button>
        </form>

        <!-- Your Existing Place Order Button -->
        <a asp-controller="Orders" asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-medium">
            <i class="bi bi-cart-plus me-2"></i> Place Order
        </a>
    </div>
}

<div class="card-custom border-0 shadow-sm mb-4 bg-white" style="border-radius: 1rem;">
    <!-- Informational Banner -->
    <div class="p-3 bg-light border-bottom" style="border-top-left-radius: 1rem; border-top-right-radius: 1rem;">
        <p class="text-muted small mb-0 ms-2">
            <i class="bi bi-info-circle me-1"></i> Placing an order creates a real Order record and sends a message to Azure Queue Storage. Click <strong>"Process Queue"</strong> to pull pending messages, decrement the product's stock, mark the order as Processed, and write a log entry to Azure Files.
        </p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="p-5 text-center">
            <i class="bi bi-inbox text-muted mb-3" style="font-size: 3rem; opacity: 0.5;"></i>
            <h6 class="fw-bold text-dark mb-1">No Orders Found</h6>
            <p class="text-muted small">Place a new order to see it appear here.</p>
        </div>
    }
    else
    {
        <div class="table-responsive p-3">
            <table class="table table-hover align-middle mb-0">
                <thead class="text-muted small fw-semibold border-bottom">
                    <tr>
                        <th class="ps-3 py-3 border-0">Customer</th>
                        <th class="py-3 border-0">Product</th>
                        <th class="py-3 border-0 text-center">Qty</th>
                        <th class="py-3 border-0">Status</th>
                        <th class="pe-3 py-3 border-0 text-end">Order Date</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="ps-3 py-3 text-dark fw-medium">@order.CustomerId</td>
                            <td class="py-3 text-dark">@order.ProductId</td>
                            <td class="py-3 text-center text-muted">@order.Quantity</td>
                            <td class="py-3">
                                @if (order.Status == "Pending")
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                        <i class="bi bi-hourglass-split me-1"></i> Pending
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        <i class="bi bi-check-circle me-1"></i> Processed
                                    </span>
                                }
                            </td>
                            <td class="pe-3 py-3 text-end text-muted small">
                                @if(order.Timestamp != null)
                                {
                                    @order.Timestamp.Value.ToString("dd MMM yyyy, HH:mm")
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>