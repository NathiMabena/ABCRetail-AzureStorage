<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ABC Retail</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <style>
        body {
            background-color: #f4f6f9;
        }

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            width: 240px;
            background-color: #1e2a38;
            color: #fff;
            padding-top: 1rem;
        }

        .sidebar .brand {
            font-weight: 700;
            font-size: 1.25rem;
            padding: 0.75rem 1.25rem 1.5rem;
            display: block;
            color: #fff;
        }

        .sidebar .nav-link {
            color: #c7d0da;
            padding: 0.65rem 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background-color: #2a3b4d;
            color: #fff;
        }

        .main-wrapper {
            margin-left: 240px;
        }

        .topbar {
            background-color: #fff;
            border-bottom: 1px solid #e3e6ea;
            padding: 0.75rem 1.5rem;
        }

        .content-area {
            padding: 1.5rem;
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <nav class="sidebar">
        <a class="brand" href="/">
            <i class="bi bi-shop"></i> ABC Retail
        </a>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Customers" asp-action="Index">
                    <i class="bi bi-people"></i> Customers &amp; Products
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Images" asp-action="Index">
                    <i class="bi bi-images"></i> Images
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Orders" asp-action="Index">
                    <i class="bi bi-cart-check"></i> Orders &amp; Inventory
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Logs" asp-action="Index">
                    <i class="bi bi-file-earmark-text"></i> Logs
                </a>
            </li>
        </ul>
    </nav>

    <!-- Main content -->
    <div class="main-wrapper">
        <div class="topbar d-flex justify-content-between align-items-center">
            <h5 class="mb-0">@ViewData["Title"]</h5>
            <span class="text-muted small">ABC Retail Internal Tool</span>
        </div>

        <div class="content-area">
            @RenderBody()
        </div>
    </div>

    <!-- Toast container (used later for notifications) -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3"></div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
