@{
    ViewData["Title"] = "Welcome";
    Layout = "_Layout"; // Uses your main layout framework
}

<div class="container py-4">
    <!-- Hero Welcome Banner -->
    <div class="card-custom p-5 text-center shadow-sm border-0 mb-5 position-relative overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #fff;">
        <div class="position-relative z-1 py-4">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-medium mb-3">
                <i class="bi bi-cloud-check-fill me-1"></i> Azure Cloud Infrastructure Ready
            </span>
            <h1 class="display-4 fw-bold mb-3">Welcome to ABC Retail Portal</h1>
            <p class="lead text-light opacity-75 mx-auto mb-4" style="max-width: 650px;">
                An enterprise-grade management platform built on high-performance Microsoft Azure Storage services for real-time inventory, customer analytics, and queue processing.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-4 shadow fw-medium">
                    <i class="bi bi-speedometer2 me-2"></i> Launch Dashboard
                </a>
                <a asp-controller="Orders" asp-action="Create" class="btn btn-outline-light btn-lg rounded-pill px-4 fw-medium">
                    <i class="bi bi-cart-plus me-2"></i> Place Order
                </a>
            </div>
        </div>
    </div>

    <!-- Feature Showcase Grid (Microsoft Edge Onboarding Style) -->
    <div class="mb-5">
        <div class="text-center mb-4">
            <h4 class="fw-bold text-dark mb-1">Architecture & Capabilities</h4>
            <p class="text-muted small">Explore how ABC Retail leverages four core Microsoft Azure Storage services.</p>
        </div>

        <div class="row g-4">
            <!-- Grid Item 1: Table Storage -->
            <div class="col-md-6 col-lg-3">
                <div class="stat-card position-relative h-100 p-4 d-flex flex-column border-0 shadow-sm bg-white">
                    <div class="icon-shape bg-primary-subtle text-primary mb-3" style="width: 52px; height: 52px; font-size: 1.5rem;">
                        <i class="bi bi-table"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Azure Table Storage</h6>
                    <p class="text-muted small mb-3 flex-grow-1">
                        High-throughput NoSQL key-value store managing relational customer records, product catalogs, and order entities with partition indexing.
                    </p>
                    <a asp-controller="Customers" asp-action="Index" class="text-primary fw-medium small text-decoration-none stretched-link">
                        Manage Tables
                    </a>
                </div>
            </div>

            <!-- Grid Item 2: Blob Storage -->
            <div class="col-md-6 col-lg-3">
                <div class="stat-card position-relative h-100 p-4 d-flex flex-column border-0 shadow-sm bg-white">
                    <div class="icon-shape bg-info-subtle text-info mb-3" style="width: 52px; height: 52px; font-size: 1.5rem;">
                        <i class="bi bi-images"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Azure Blob Storage</h6>
                    <p class="text-muted small mb-3 flex-grow-1">
                        Unstructured media repository storing high-resolution product imagery with GUID prefixing and secure controller streaming endpoints.
                    </p>
                    <a asp-controller="Images" asp-action="Index" class="text-info fw-medium small text-decoration-none stretched-link">
                        Explore Media
                    </a>
                </div>
            </div>

            <!-- Grid Item 3: Queue Storage -->
            <div class="col-md-6 col-lg-3">
                <div class="stat-card position-relative h-100 p-4 d-flex flex-column border-0 shadow-sm bg-white">
                    <div class="icon-shape bg-warning-subtle text-warning mb-3" style="width: 52px; height: 52px; font-size: 1.5rem;">
                        <i class="bi bi-stack"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Azure Queue Storage</h6>
                    <p class="text-muted small mb-3 flex-grow-1">
                        Asynchronous message queue decoupling order placement from background inventory deduction workers for peak performance.
                    </p>
                    <a asp-controller="Orders" asp-action="Index" class="text-warning fw-medium small text-decoration-none stretched-link">
                        View Queue
                    </a>
                </div>
            </div>

            <!-- Grid Item 4: Azure Files -->
            <div class="col-md-6 col-lg-3">
                <div class="stat-card position-relative h-100 p-4 d-flex flex-column border-0 shadow-sm bg-white">
                    <div class="icon-shape bg-success-subtle text-success mb-3" style="width: 52px; height: 52px; font-size: 1.5rem;">
                        <i class="bi bi-file-earmark-code"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Azure Files</h6>
                    <p class="text-muted small mb-3 flex-grow-1">
                        Shared SMB cloud file system storing automated worker execution logs, transaction details, and audit records in real time.
                    </p>
                    <a asp-controller="Logs" asp-action="Index" class="text-success fw-medium small text-decoration-none stretched-link">
                        Inspect Logs
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Edge-Style Initialization Progress Bar at the Bottom -->
    <div class="card-custom p-4 shadow-sm border-0 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="small fw-semibold text-dark d-flex align-items-center">
                <i class="bi bi-cpu-fill text-primary me-2"></i> System Status: <span id="statusText" class="ms-1 text-primary">Initializing Azure Services...</span>
            </span>
            <span class="small fw-bold text-primary" id="statusPercent">0%</span>
        </div>
        <div class="progress rounded-pill" style="height: 8px;">
            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" id="systemProgressBar" style="width: 0%;"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const progressBar = document.getElementById('systemProgressBar');
            const statusText = document.getElementById('statusText');
            const statusPercent = document.getElementById('statusPercent');

            let progress = 0;
            const interval = setInterval(() => {
                progress += Math.floor(Math.random() * 15) + 10;

                if (progress >= 100) {
                    progress = 100;
                    clearInterval(interval);
                    statusText.textContent = "All Azure Storage Services Online and Connected";
                    statusText.className = "ms-1 text-success fw-bold";
                    progressBar.className = "progress-bar bg-success";
                } else if (progress > 60) {
                    statusText.textContent = "Connecting to Azure Queue & File Share...";
                } else if (progress > 30) {
                    statusText.textContent = "Verifying Table & Blob Storage Endpoints...";
                }

                progressBar.style.width = progress + '%';
                statusPercent.textContent = progress + '%';
            }, 250);
        });
    </script>
}