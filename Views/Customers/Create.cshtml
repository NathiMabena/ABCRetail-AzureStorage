@model ABCRetail.AzureStorage.Models.CustomerEntity

@{
    ViewData["Title"] = "Add Customer";

    var countryOptions = new[]
    {
        new { Code = "+27", Flag = "🇿🇦", Name = "South Africa", MaxLen = 9 },
        new { Code = "+44", Flag = "🇬🇧", Name = "United Kingdom", MaxLen = 10 },
        new { Code = "+1",  Flag = "🇺🇸", Name = "United States", MaxLen = 10 },
        new { Code = "+234", Flag = "🇳🇬", Name = "Nigeria", MaxLen = 10 },
        new { Code = "+254", Flag = "🇰🇪", Name = "Kenya", MaxLen = 9 },
    };
}

<div class="row justify-content-center mt-4">
    <div class="col-lg-6 col-md-8">
        <div class="card-custom p-4 shadow-sm">
            <form asp-action="Create" method="post" id="customerForm">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-medium text-dark">Full Name</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Nkosinathi Mabena" />
                    </div>
                    <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-medium text-dark">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" type="email" placeholder="nathi@example.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-medium text-dark">Phone Number</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                        <select id="countryCode" class="form-select px-2" style="max-width: 110px; border-radius: 0;">
                            @foreach (var c in countryOptions)
                            {
                                <option value="@c.Code" data-maxlen="@c.MaxLen" data-country="@c.Name" selected="@(c.Code == "+27" ? "selected" : null)">
                                    @c.Flag @c.Code
                                </option>
                            }
                        </select>
                        <input type="text" id="phoneNumber" class="form-control" inputmode="numeric" placeholder="Number without country code" />
                    </div>
                    <div class="form-text mt-1 text-muted" id="phoneHint"></div>
                    <input type="hidden" asp-for="Phone" id="phoneHidden" />
                    <span asp-validation-for="Phone" class="text-danger small mt-1 d-block"></span>
                </div>

                <hr class="my-4 text-muted" />

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i> Save Customer
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const countrySelect = document.getElementById('countryCode');
        const numberInput = document.getElementById('phoneNumber');
        const hint = document.getElementById('phoneHint');
        const hiddenPhone = document.getElementById('phoneHidden');

        function applyMaxLength() {
            const selected = countrySelect.options[countrySelect.selectedIndex];
            const len = parseInt(selected.dataset.maxlen, 10);
            const countryName = selected.dataset.country;

            numberInput.setAttribute('maxlength', len);
            numberInput.setAttribute('minlength', len);
            numberInput.setAttribute('pattern', `\\d{${len}}`);
            numberInput.setAttribute('required', 'required');

            hint.textContent = `Exactly ${len} digits required for ${countryName}`;
        }

        function combinePhone() {
            hiddenPhone.value = numberInput.value.length > 0
                ? countrySelect.value + numberInput.value
                : '';
        }

        numberInput.addEventListener('input', function () {
            this.value = this.value.replace(/\D/g, '').replace(/^0+/, '');
        });

        countrySelect.addEventListener('change', applyMaxLength);
        applyMaxLength();

        document.getElementById('customerForm').addEventListener('submit', combinePhone);
    </script>
}