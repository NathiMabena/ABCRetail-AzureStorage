@model List<ABCRetail.AzureStorage.Models.CustomerEntity>
@{
    ViewData["Title"] = "Customers";
}

<!-- Inject the button into the Layout's topbar -->
@section TopbarActions {
    <a asp-action="Create" class="btn btn-primary rounded-pill px-3 fw-medium shadow-sm">
        <i class="bi bi-person-plus-fill me-1"></i> Add Customer
    </a>
}

@if (Model == null || Model.Count == 0)
{
    <!-- Empty State: Shows ONLY when there are zero customers -->
    <div class="card-custom p-5 text-center shadow-sm">
        <div class="d-flex flex-column align-items-center justify-content-center py-5">
            <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 72px; height: 72px;">
                <i class="bi bi-people-fill fs-1"></i>
            </div>
            <h5 class="fw-bold text-dark mb-2">No customers found</h5>
            <p class="text-muted mb-4" style="max-width: 400px;">
                It looks like your database is empty. Start building your customer base by adding your first record to Azure Table Storage.
            </p>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm fw-medium">
                <i class="bi bi-person-plus-fill me-2"></i> Add First Customer
            </a>
        </div>
    </div>
}
else
{
    <!-- Data Table: Shows ONLY when customers exist -->
    <div class="card-custom overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3 text-muted fw-semibold">Customer Name</th>
                        <th class="py-3 text-muted fw-semibold">Email</th>
                        <th class="py-3 text-muted fw-semibold">Phone</th>
                        <th class="text-end pe-4 py-3 text-muted fw-semibold">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-medium text-dark">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px;">
                                        @(string.IsNullOrWhiteSpace(item.Name) ? "?" : item.Name.Substring(0, 1).ToUpper())
                                    </div>
                                    @item.Name
                                </div>
                            </td>
                            <td><a href="mailto:@item.Email" class="text-decoration-none text-secondary">@item.Email</a></td>
                            <td class="text-secondary">@item.Phone</td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-partitionKey="@item.PartitionKey" asp-route-rowKey="@item.RowKey" class="btn btn-sm btn-light border text-primary me-1">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-light border text-danger" onclick="openDeleteModal('@item.PartitionKey', '@item.RowKey', '@item.Name')">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark">Delete Customer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-secondary">
                Are you sure you want to delete <strong id="deleteCustomerName" class="text-dark"></strong>? This action cannot be undone.
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" method="post" id="deleteForm">
                    <input type="hidden" name="partitionKey" id="delPartitionKey" />
                    <input type="hidden" name="rowKey" id="delRowKey" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openDeleteModal(partitionKey, rowKey, customerName) {
            document.getElementById('delPartitionKey').value = partitionKey;
            document.getElementById('delRowKey').value = rowKey;
            document.getElementById('deleteCustomerName').textContent = customerName;
            var myModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            myModal.show();
        }
    </script>
}