@model List<ABCRetail.AzureStorage.Models.CustomerProductEntity>

@{
    ViewData["Title"] = "Customers & Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Customers &amp; Products</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Add New
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Product</th>
                    <th>Price</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No records yet. Click "Add New" to get started.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Email</td>
                            <td>@item.ProductName</td>
                            <td>R@(item.Price.ToString("N2"))</td>
                            <td class="text-end">
                                <form asp-action="Delete" method="post" class="d-inline">
                                    <input type="hidden" name="partitionKey" value="@item.PartitionKey" />
                                    <input type="hidden" name="rowKey" value="@item.RowKey" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Delete this record?');">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
